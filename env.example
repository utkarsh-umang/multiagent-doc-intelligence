# Copy to `.env` and fill in values. Do NOT commit real secrets.

# --- Core provider keys (at least one is required for LiteLLM) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# --- Model selection (all optional; sensible defaults exist) ---
# Extractor uses a vision-capable model.
LITELLM_VISION_MODEL=gpt-4o
OPENAI_VISION_MODEL=
EXTRACTOR_MODEL=
EXTRACTOR_RETRY_MODEL=
LITELLM_VISION_RETRY_MODEL=

# Validator + auditor models.
VALIDATOR_MODEL=anthropic/claude-sonnet-4-6
ANTHROPIC_VALIDATOR_MODEL=
AUDITOR_MODEL=gpt-4o
OPENAI_AUDITOR_MODEL=

# DuckDB "Ask Stored Runs" fallback model (optional).
QUERY_SQL_MODEL=

# --- Storage ---
# In Docker, Compose sets NOVA_DB_PATH to /app/data/app.duckdb.
# For local (non-Docker) runs you can override it.
NOVA_DB_PATH=

# --- Langfuse tracing (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# If you use Langfuse via OTLP (litellm langfuse_otel callback), you can set:
LANGFUSE_OTEL_HOST=
# Opt-in for LangGraph node decorators (observe()).
NOVA_LANGFUSE_DECORATORS=false

# --- Validator behavior toggles (optional) ---
VALIDATOR_LLM_FALLBACK_ON_MISMATCH=false
VALIDATOR_LLM_FALLBACK_ALLOW_HARD_RULES=false
